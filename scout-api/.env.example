# Scout API Configuration
# Copy this to .env and fill in your values

# LinkedIn cookie for LinkedIn scraping (optional)
# Get it: Chrome DevTools > Application > Cookies > linkedin.com > li_at
LINKEDIN_COOKIE=

# Proxy configuration (optional)
# Single proxy:
SCOUT_PROXY=
# Or use a file with one proxy per line:
SCOUT_PROXY_FILE=proxies.txt
# Or use free anonymous proxies (unreliable):
SCOUT_FREE_PROXY=false

# Hunter.io API key for extra email coverage (optional)
HUNTER_API_KEY=

# CORS origins allowed to call this API
ALLOWED_ORIGINS=https://localrank.com.co,http://localhost:3000

# Server port
PORT=8000
